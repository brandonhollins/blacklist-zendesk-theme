<section id="main-content" class="bl-hero bl-dark">
  {{#isnt settings.shader_palette 'none'}}
    <canvas class="bl-shader" data-shader="{{settings.shader_palette}}" aria-hidden="true"></canvas>
  {{/isnt}}
  <div class="bl-wrap bl-screen bl-hero-inner">
    <div class="bl-hero-search">
      <h2 class="bl-meta">({{t 'search'}})</h2>
      <div class="bl-search bl-search-large">
        {{search submit=false instant=settings.instant_search class='search search-full'}}
      </div>
    </div>
    <div>
      <h1 class="bl-display-4xl bl-headline">{{help_center.name}}</h1>
      <div class="bl-hero-meta">
        {{#link 'new_request' class='bl-meta bl-hero-link'}}Submit a ticket{{/link}}
        {{#if help_center.community_enabled}}
          {{#link 'community' class='bl-meta bl-hero-link'}}{{t 'community'}}{{/link}}
        {{/if}}
      </div>
    </div>
  </div>
</section>

<section class="bl-section knowledge-base">
  <div class="bl-wrap bl-screen">
    <h2 class="bl-display-4xl bl-headline bl-section-heading">{{t 'categories'}}</h2>
    <ul class="bl-index bl-hover-list">
      {{#each categories}}
        {{#if ../has_multiple_categories}}
          <li class="bl-index-item">
            <a href="{{url}}" class="bl-index-link">
              <span class="bl-meta bl-muted bl-counter" aria-hidden="true"></span>
              <span class="bl-text-xl bl-title">{{name}}</span>
              {{#if description}}
                <span class="bl-meta-value bl-index-description">{{excerpt description characters=140}}</span>
              {{/if}}
            </a>
          </li>
        {{else}}
          {{#each sections}}
            <li class="bl-index-item">
              <a href="{{url}}" class="bl-index-link">
                <span class="bl-meta bl-muted bl-counter" aria-hidden="true"></span>
                <span class="bl-text-xl bl-title">{{name}}</span>
                {{#if description}}
                  <span class="bl-meta-value bl-index-description">{{excerpt description characters=140}}</span>
                {{/if}}
              </a>
            </li>
          {{/each}}
        {{/if}}
      {{/each}}
    </ul>
    {{pagination}}
  </div>
</section>

{{#if promoted_articles}}
  <section class="bl-section bl-dark">
    <div class="bl-wrap bl-block">
      <div class="bl-grid">
        <h2 class="bl-display-2xl bl-headline bl-split-heading">{{t 'promoted_articles'}}</h2>
        <ul class="bl-rows bl-hover-list bl-split-body">
          {{#each promoted_articles}}
            <li class="bl-row">
              <a href="{{url}}" class="bl-row-link">
                <span class="bl-meta bl-muted bl-counter" aria-hidden="true"></span>
                <span class="bl-text-lg bl-title">
                  {{title}}
                  {{#if internal}}
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" focusable="false" viewBox="0 0 16 16" class="icon-lock" title="{{t 'internal'}}">
                      <rect width="12" height="9" x="2" y="7" fill="currentColor" rx="1" ry="1"/>
                      <path fill="none" stroke="currentColor" d="M4.5 7.5V4a3.5 3.5 0 017 0v3.5"/>
                    </svg>
                  {{/if}}
                </span>
              </a>
            </li>
          {{/each}}
        </ul>
      </div>
    </div>
  </section>
{{/if}}

{{#if help_center.community_enabled}}
  <section class="bl-section">
    <div class="bl-wrap bl-block">
      <div class="bl-grid">
        <h2 class="bl-display-2xl bl-headline bl-split-heading">{{t 'community'}}</h2>
        {{#link 'community' class='bl-promo bl-dark bl-split-body'}}
          {{#isnt settings.shader_palette 'none'}}
            <canvas class="bl-shader" data-shader="{{settings.shader_palette}}" aria-hidden="true"></canvas>
          {{/isnt}}
          <span class="bl-meta">({{t 'community'}})</span>
          <span class="bl-display-lg bl-headline">{{t 'join_conversation'}}</span>
        {{/link}}
      </div>
    </div>
  </section>
{{/if}}

{{#if settings.show_recent_activity}}
  <section class="bl-section activity">
    <div class="bl-wrap bl-block">
      {{recent_activity}}
    </div>
  </section>
{{/if}}
